{
  "name": "the-archivist-obsidian",
  "version": "0.1.0",
  "description": "Obsidian plugin that keeps a vault's notes in The Archivist",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -p tsconfig.json && node esbuild.config.mjs production",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.27.7",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "^1.14.4",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "private": true
}
